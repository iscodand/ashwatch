meta {
  name: Create Tenant
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/tenants
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "authorId": "11111111-1111-1111-1111-111111111111",
    "name": "Empresa Teste",
    "description": "Tenant criado para teste de deploy"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("tenantId", res.body.id);
  }
}
